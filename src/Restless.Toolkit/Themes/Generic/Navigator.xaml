<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="clr-namespace:Restless.Toolkit.Controls">

    <ControlTemplate x:Key="ControlTemplate.NavigaorItem" TargetType="con:NavigatorItem">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Padding="{TemplateBinding Padding}"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

            <Grid Margin="{TemplateBinding InternalGridMargin}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="16"/>
                </Grid.RowDefinitions>

                <ContentPresenter Content="{TemplateBinding Icon}"/>

                <Path
                    Fill="{TemplateBinding IconBrush}"
                    Data="{TemplateBinding IconGeometry}"/>

                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Text="{TemplateBinding Title}"/>
            </Grid>
        </Border>
    </ControlTemplate>

    <Style x:Key="Style.NavigatorItem" TargetType="con:NavigatorItem">
        <Style.Resources>
            <Style TargetType="Path">
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Width" Value="14"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
        </Style.Resources>

        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0,10"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template" Value="{StaticResource ControlTemplate.NavigaorItem}"/>

        <Style.Triggers>
            <Trigger Property="IsItemVisible" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>

    </Style>

    <Style TargetType="con:NavigatorItem" BasedOn="{StaticResource Style.NavigatorItem}"/>

    <ControlTemplate x:Key="ControlTemplate.MainNavigator" TargetType="con:MainNavigator">
        <con:NavigatorExpander
            Header="{TemplateBinding HeaderText}"
            IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource Mode=TemplatedParent}}">

            <ItemsPresenter/>

        </con:NavigatorExpander>
    </ControlTemplate>

    <Style x:Key="Style.MainNavigator" TargetType="con:MainNavigator">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template" Value="{StaticResource ControlTemplate.MainNavigator}"/>
    </Style>

    <Style TargetType="con:MainNavigator" BasedOn="{StaticResource Style.MainNavigator}"/>

</ResourceDictionary>